# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys or passwords.

# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database (Phase 0/1) ----
# Postgres connection string. For Supabase: Project Settings > Database > Connection string (URI, "Session" mode).
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# ---- Google Reviews — own listings (Phase 2) ----
# From a Google Cloud project with the Business Profile API enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---- Google Reviews — competitor listings (Phase 2) ----
# A Google Cloud API key with the Places API enabled (no OAuth needed, public data only).
GOOGLE_PLACES_API_KEY=

# ---- Trustpilot — own listings (Phase 2) ----
# From a Trustpilot Business account.
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=

# ---- Claude API (Phase 3) ----
# From console.anthropic.com — used for sentiment scoring, theming, reply drafts, and digest summaries.
ANTHROPIC_API_KEY=

# ---- Email digest (Phase 6) ----
# Pick one provider and fill in only that section.
EMAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAILS=

# ---- Auth (Phase 7) ----
SESSION_SECRET=
